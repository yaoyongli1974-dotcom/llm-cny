{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "llm-cny",
  "version": "2.0.0",
  "description": "在 OpenCode TUI 右侧栏显示多家 LLM 提供商的人民币费用、DeepSeek/moonshot China 余额和 Codex 限额。",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "deepseek",
    "kimi",
    "moonshot",
    "mimo",
    "xiaomi",
    "zhipuai",
    "glm",
    "alibaba",
    "qwen",
    "minimax",
    "cny",
    "billing"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "bun run ./scripts/build.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opencode/theme": ">=2.0.0",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode/theme": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/client": "^2.0.32",
    "@opencode/plugin": "^2.0.32",
    "@opencode/theme": "^2.0.32",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/bun": "^1.3.13",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "^1.9.10",
    "typescript": "^5.8.2",
    "bun-types": "^1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahasasjeb/opencode-tui-deepseek-cny.git"
  }
}
